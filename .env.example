# Copie ce fichier en .env pour recevoir les nouvelles offres par email.
# Gmail : crée un « mot de passe d'application » (Compte Google > Sécurité > Validation en 2 étapes).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ton.adresse@gmail.com
SMTP_PASSWORD=mot_de_passe_application
NOTIFY_TO=ton.adresse@gmail.com
